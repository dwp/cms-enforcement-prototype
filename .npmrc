registry=https://registry.npmjs.org/

# DWP GOV.UK package scope -> GitLab group registry
@dwp-govuk:registry=https://gitlab.com/api/v4/groups/dwp/-/packages/npm/
//gitlab.com/api/v4/groups/dwp/-/packages/npm/:_authToken=${NPM_TOKEN}

# Core DWP frontend packages -> Nexus
@dwp:registry=https://registry.npmjs.org/